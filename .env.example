# Food Verse AI — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

APP_NAME="Food Verse AI"
APP_VERSION="4.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000

# =========================================================================
# Part 4: Authentication & Database
# =========================================================================
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_generate_with_secrets_token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Leave blank for SQLite local development.
# PostgreSQL: postgresql+psycopg2://user:password@host/dbname
DATABASE_URL=

# =========================================================================
# Google Gemini API (multimodal vision + LLM)
# Obtain at: https://aistudio.google.com/app/apikey
# =========================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# =========================================================================
# USDA FoodData Central API
# Obtain at: https://fdc.nal.usda.gov/api-guide.html
# =========================================================================
USDA_API_KEY=your_usda_api_key_here

# Model Identifiers (do not change unless you know the supported models)
AI_VISION_MODEL="gemini-3.5-flash-lite"
FRESHNESS_MODEL_NAME="gemini-3.5-flash-lite"
HYGIENE_MODEL_NAME="gemini-3.5-flash-lite"
COOKING_LLM_MODEL="gemini-3.5-flash-lite"
MEAL_PLANNER_MODEL="gemini-3.5-flash-lite"
